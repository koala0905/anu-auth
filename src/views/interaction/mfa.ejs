<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Two-factor authentication</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eff6ff',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
            },
            accent: {
              50: '#f5f3ff',
            },
            error: {
              50: '#fef2f2',
              100: '#fee2e2',
              700: '#b91c1c',
            },
          },
        },
      },
    };
  </script>

  <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body>

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-brand-50 via-white to-accent-50 px-4 py-8">

  <div class="w-full max-w-md">

    <!-- Logo / Brand -->
    <div class="flex flex-col items-center mb-8">

      <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center shadow-lg shadow-brand-500/30 mb-4">
        <i data-lucide="shield-check" class="w-8 h-8 text-white"></i>
      </div>

      <h1 class="text-2xl font-bold text-slate-900">
        Two-factor authentication
      </h1>

      <p class="text-sm text-slate-500 mt-1">
        Enter the 6-digit code from your authenticator app
      </p>

    </div>


    <!-- Card -->
    <div class="bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 p-8">

      <form method="post" action="" class="space-y-5">

        <!-- Code -->
        <div>

          <label class="block text-sm font-medium text-slate-700 mb-1.5">
            Verification code
          </label>

          <div class="relative">

            <i
              data-lucide="keypad"
              class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"
            ></i>

            <input
              type="text"
              name="token"
              required
              autofocus
              inputmode="numeric"
              autocomplete="one-time-code"
              pattern="[0-9]*"
              maxlength="6"
              placeholder="000000"
              class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-200 text-slate-900 placeholder-slate-400 tracking-[0.5em] focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none transition-all text-sm"
            >

          </div>

        </div>


        <!-- Error -->
        <% if (typeof error !== 'undefined' && error) { %>

          <div class="flex items-start gap-2 p-3 rounded-lg bg-error-50 border border-error-100 text-sm text-error-700">

            <i
              data-lucide="circle-alert"
              class="w-4 h-4 flex-shrink-0 mt-0.5"
            ></i>

            <span><%= error %></span>

          </div>

        <% } %>


        <!-- Submit -->
        <button
          type="submit"
          class="w-full py-2.5 rounded-lg bg-brand-600 text-white font-medium hover:bg-brand-700 focus:ring-2 focus:ring-brand-500/20 focus:outline-none transition-all flex items-center justify-center gap-2 text-sm shadow-md shadow-brand-500/20"
        >

          <i data-lucide="shield-check" class="w-4 h-4"></i>

          Verify

        </button>

      </form>

    </div>


    <!-- Security footer -->
    <p class="text-center text-xs text-slate-400 mt-6 flex items-center justify-center gap-1.5">

      <i data-lucide="shield" class="w-3 h-3"></i>

      Protected by end-to-end encryption

    </p>

  </div>

</div>


<script>

  lucide.createIcons();

</script>

</body>
</html>
